[Version]
Signature="$WINDOWS NT$"
Class=Display
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%MfgName%
DriverVer=07/27/2026,1.0.0.0
CatalogFile=VirtualDisplayDriver.cat

[Manufacturer]
%MfgName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=DriverInstall,Root\RotaScope_VirtualDisplay

[DriverInstall.NT]
CopyFiles=DriverCopyFiles

[DestinationDirs]
DriverCopyFiles=12

[DriverCopyFiles]
VirtualDisplayDriver.sys

[DriverInstall.NT.Services]
AddService=RotaScopeDisplay,0x00000002,ServiceInst

[ServiceInst]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\VirtualDisplayDriver.sys

[Strings]
MfgName="RotaScope"
DeviceName="RotaScope Virtual Display"
ServiceName="RotaScope Virtual Display Driver"
