[Version]
Signature="$WINDOWS NT$"
Class=Display
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%MfgName%
DriverVer=08/01/2025,1.0.0.0
CatalogFile=VirtualDisplay.cat

[Manufacturer]
%MfgName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=Install,Root\VirtualDisplay
%DeviceName%=Install,SWD\Generic\VirtualDisplay

[Install]
CopyFiles=DriverCopyFiles
AddReg=DriverAddReg

[Install.Services]
AddService=VirtualDisplay,0x00000002,Service_Inst

[DriverCopyFiles]
VirtualDisplay.sys

[DriverAddReg]
HKR,,HardwareInformation.MemorySize,0x00010003,0x20000000
HKR,,HardwareInformation.ChipType,,"RotaScope Virtual GPU"
HKR,,HardwareInformation.DacType,,"Internal"

[Service_Inst]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\VirtualDisplay.sys

[Strings]
MfgName="RotaScope"
DeviceName="RotaScope Virtual Display Adapter"
ServiceName="RotaScope Virtual Display"

; Description strings
RotaScope.DeviceDesc = "RotaScope Virtual Display Adapter"
RotaScope.SVCDesc = "RotaScope Virtual Display Driver"
RotaScope.Provider = "RotaScope"
